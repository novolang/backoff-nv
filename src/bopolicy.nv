// bopolicy.nv — a retry policy as a value.
//
// A client that fails and retries immediately turns one failure into
// many.  A thousand clients that all retry after exactly one second hit
// a recovering service with a thousand requests one second later, which
// is called a thundering herd.  A retry policy is the pair of decisions
// that prevents both: how long to wait before the next attempt, and
// when to stop.
//
// A policy has one of four shapes.  A constant policy waits the same
// time every attempt.  A linear one adds a fixed step each time.  An
// exponential one multiplies by a factor, which is what almost every
// client should use.  A decorrelated one grows from the last delay it
// produced rather than from the attempt number.  It is the form the AWS
// Architecture Blog's "Exponential Backoff and Jitter" recommends, and
// it needs a ceiling.
//
// A policy with no jitter puts every client that failed at the same
// moment back on the wire at the same moment.  `exponential` comes with
// full jitter and `decorrelated` with decorrelated jitter.  `constant`
// and `linear` come with none, since they are for a dependency whose
// recovery time is known rather than for a herd.

use bofault

// How a computed delay is spread out.
//
// ```novo
// use bopolicy
//
// fn main() [io]
//     println(bopolicy.jitter_name(BoFullJitter))   // full
// ```
pub enum BoJitter
    // None.  Every client waits exactly the computed delay, so every
    // client that failed together retries together.  For a test, or
    // for a single client where a herd cannot form.
    BoNoJitter
    // Uniformly between zero and the computed delay.  The form that
    // clears a herd fastest, at the cost of some very short waits.
    BoFullJitter
    // Half the computed delay, plus uniformly up to the other half.
    // Keeps a floor under every wait, which matters when the retry
    // itself is expensive.
    BoEqualJitter
    // Uniformly between the base delay and the computed delay.  With
    // the decorrelated shape, whose computed delay is three times the
    // last delay, this is the AWS "decorrelated jitter": a client that
    // has already backed off a long way does not restart from the
    // bottom.
    BoDecorrelatedJitter

// How the delay grows from one attempt to the next.
//
// ```novo
// use bopolicy
//
// fn main() [io]
//     println(bopolicy.shape_name(bopolicy.linear(100, 50).shape))   // linear
// ```
pub enum BoShape
    // The base delay, every attempt.
    BoConstant
    // The base delay plus one step per attempt after the first.
    BoLinear
    // The base delay multiplied by the factor once per attempt after
    // the first.
    BoExponential
    // Three times the last delay, and three times the base delay
    // before there is one.
    BoDecorrelated

// A retry policy.
//
// Built by `constant`, `linear`, `exponential` or `decorrelated` and
// narrowed by the `with_` functions.  The fields are readable so a
// test can assert on them and a start-up log can print them.
pub struct BoPolicy
    // How the delay grows.
    shape: BoShape
    // The first delay, in milliseconds.  Every shape starts here.
    base_millis: Int
    // What a linear policy adds each attempt, in milliseconds.  `0`
    // for the other shapes.
    step_millis: Int
    // What an exponential policy multiplies by each attempt.  `1.0`
    // for the other shapes.
    factor: Float
    // The ceiling on one delay, in milliseconds, or `0` for none.
    max_millis: Int
    // The most attempts, the first one included, or `0` for no limit.
    max_attempts: Int
    // The most time the whole sequence may span, in milliseconds, or
    // `0` for no budget.  Measured from the first attempt.  It stops a
    // policy with a long ceiling from retrying for an hour.
    budget_millis: Int
    // How the computed delay is spread out.
    jitter: BoJitter

// The jitter's stable name: `"none"`, `"full"`, `"equal"`,
// `"decorrelated"`.
//
// ```novo
// use bopolicy
//
// fn main() [io]
//     println(bopolicy.jitter_name(BoEqualJitter))  // equal
// ```
pub fn jitter_name(j: BoJitter) -> Str
    match j
        BoNoJitter           => "none"
        BoFullJitter         => "full"
        BoEqualJitter        => "equal"
        BoDecorrelatedJitter => "decorrelated"

// A policy that waits the same time every attempt.
//
// For a dependency whose recovery time is known and does not depend on
// load — a lock, a leader election, a file a process is writing.
//
// ```novo
// use bopolicy
//
// fn main() [io]
//     let p = bopolicy.constant(250)
//     println("${p.base_millis}")                   // 250
// ```
pub fn constant(millis: Int) -> BoPolicy
    policy(BoConstant, millis, 0, 1.0, 0, BoNoJitter)

// A policy that adds `step` milliseconds each attempt.
//
// ```novo
// use bopolicy
//
// fn main() [io]
//     let p = bopolicy.linear(100, 100)
//     println("${p.step_millis}")                   // 100
// ```
pub fn linear(base_millis: Int, step_millis: Int) -> BoPolicy
    policy(BoLinear, base_millis, step_millis, 1.0, 0, BoNoJitter)

// A policy that multiplies by `factor` each attempt, with full jitter.
//
// The default every client should start from.  `exponential(100, 2.0)`
// computes 100, 200, 400, 800 milliseconds and spreads each one
// uniformly between zero and itself.
//
// ```novo
// use bopolicy
//
// fn main() [io]
//     let p = bopolicy.exponential(100, 2.0)
//     println(bopolicy.jitter_name(p.jitter))       // full
// ```
pub fn exponential(base_millis: Int, factor: Float) -> BoPolicy
    policy(BoExponential, base_millis, 0, factor, 0, BoFullJitter)

// A policy that grows from the last delay rather than from the attempt
// number, capped at `max_millis`.
//
// Each delay is uniform between the base and three times the previous
// delay, and the first between the base and three times the base.
// The ceiling is required: without one the sequence has no bound, and
// `check` refuses a maximum of `0`.
//
// ```novo
// use bopolicy
//
// fn main() [io]
//     let p = bopolicy.decorrelated(100, 20000)
//     println("${p.max_millis}")                    // 20000
// ```
pub fn decorrelated(base_millis: Int, max_millis: Int) -> BoPolicy
    policy(BoDecorrelated, base_millis, 0, 1.0, max_millis, BoDecorrelatedJitter)

// The policy with a ceiling on one delay.
//
// ```novo
// use bopolicy
//
// fn main() [io]
//     let p = bopolicy.with_max_delay(bopolicy.exponential(100, 2.0), 30000)
//     println("${p.max_millis}")                    // 30000
// ```
pub fn with_max_delay(p: BoPolicy, millis: Int) -> BoPolicy
    BoPolicy {
        shape: p.shape,
        base_millis: p.base_millis,
        step_millis: p.step_millis,
        factor: p.factor,
        max_millis: millis,
        max_attempts: p.max_attempts,
        budget_millis: p.budget_millis,
        jitter: p.jitter }

// The policy with a limit on the number of attempts, the first
// included.
//
// `with_max_attempts(p, 3)` allows one attempt and two retries.
//
// ```novo
// use bopolicy
//
// fn main() [io]
//     let p = bopolicy.with_max_attempts(bopolicy.exponential(100, 2.0), 3)
//     println("${p.max_attempts}")                  // 3
// ```
pub fn with_max_attempts(p: BoPolicy, attempts: Int) -> BoPolicy
    BoPolicy {
        shape: p.shape,
        base_millis: p.base_millis,
        step_millis: p.step_millis,
        factor: p.factor,
        max_millis: p.max_millis,
        max_attempts: attempts,
        budget_millis: p.budget_millis,
        jitter: p.jitter }

// The policy with a total time budget in milliseconds.
//
// The budget is what a caller with a deadline has: a request that must
// answer in two seconds cannot spend thirty retrying, however many
// attempts its policy allows.  The decision is taken against the
// elapsed time the caller reports, and this package reads no clock.
//
// ```novo
// use bopolicy
//
// fn main() [io]
//     let p = bopolicy.with_budget(bopolicy.exponential(100, 2.0), 5000)
//     println("${p.budget_millis}")                 // 5000
// ```
pub fn with_budget(p: BoPolicy, millis: Int) -> BoPolicy
    BoPolicy {
        shape: p.shape,
        base_millis: p.base_millis,
        step_millis: p.step_millis,
        factor: p.factor,
        max_millis: p.max_millis,
        max_attempts: p.max_attempts,
        budget_millis: millis,
        jitter: p.jitter }

// The policy with a different jitter.
//
// ```novo
// use bopolicy
//
// fn main() [io]
//     let p = bopolicy.with_jitter(bopolicy.exponential(100, 2.0), BoNoJitter)
//     println(bopolicy.jitter_name(p.jitter))       // none
// ```
pub fn with_jitter(p: BoPolicy, j: BoJitter) -> BoPolicy
    BoPolicy {
        shape: p.shape,
        base_millis: p.base_millis,
        step_millis: p.step_millis,
        factor: p.factor,
        max_millis: p.max_millis,
        max_attempts: p.max_attempts,
        budget_millis: p.budget_millis,
        jitter: j }

// Whether the policy is usable, and the first fault if it is not.
//
// Run it at start-up.  The faults are checked in the order `BoFault`
// declares them.  The budget is compared with the base delay, which is
// the shortest first wait any jitter but full jitter produces.
//
// ```novo
// use bopolicy
//
// fn main() [io]
//     match bopolicy.check(bopolicy.constant(0))
//         Some(f) => println(f.message())
//         None    => println("usable")
// ```
pub fn check(p: BoPolicy) -> ?bofault.BoFault
    if p.base_millis <= 0
        return Some(BoBaseDelayNotPositive(p.base_millis))
    if is_exponential(p.shape) and p.factor <= 1.0
        return Some(BoFactorNotGreaterThanOne(p.factor))
    if p.max_millis > 0 and p.max_millis < p.base_millis
        return Some(BoMaxDelayBelowBase(p.max_millis, p.base_millis))
    if p.max_attempts < 0
        return Some(BoAttemptLimitNegative(p.max_attempts))
    if p.budget_millis > 0 and p.budget_millis < p.base_millis
        return Some(BoBudgetBelowFirstDelay(p.budget_millis, p.base_millis))
    if is_decorrelated(p.shape) and p.max_millis <= 0
        return Some(BoDecorrelatedNeedsMaxDelay)
    None

// How many uniform random numbers one decision needs.
//
// `0` for `BoNoJitter` and `1` for the other three.  A caller draws
// this many and hands them in, so every decision here can be
// reproduced from the numbers it was given.
//
// ```novo
// use bopolicy
//
// fn main() [io]
//     println("${bopolicy.uniforms_needed(bopolicy.exponential(100, 2.0))}")   // 1
// ```
pub fn uniforms_needed(p: BoPolicy) -> Int
    match p.jitter
        BoNoJitter => 0
        _          => 1

// The shape's stable name: `"constant"`, `"linear"`, `"exponential"`,
// `"decorrelated"`.
//
// ```novo
// use bopolicy
//
// fn main() [io]
//     println(bopolicy.shape_name(BoExponential))    // exponential
// ```
pub fn shape_name(s: BoShape) -> Str
    match s
        BoConstant     => "constant"
        BoLinear       => "linear"
        BoExponential  => "exponential"
        BoDecorrelated => "decorrelated"

fn policy(shape: BoShape, base: Int, step: Int, factor: Float, max: Int, j: BoJitter) -> BoPolicy
    BoPolicy {
        shape: shape,
        base_millis: base,
        step_millis: step,
        factor: factor,
        max_millis: max,
        max_attempts: 0,
        budget_millis: 0,
        jitter: j }

fn is_exponential(s: BoShape) -> Bool
    match s
        BoExponential => true
        _             => false

fn is_decorrelated(s: BoShape) -> Bool
    match s
        BoDecorrelated => true
        _              => false
